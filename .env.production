# WAGSS Production Environment
# Copy this file to .env and fill in the values

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=whatsapp
DB_USERNAME=wagss
DB_PASSWORD=GANTI_DENGAN_RANDOM_STRING
DB_POOLED=true

# JWT Secret — generate with: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING

# Server
PORT=3000
HOSTNAME=0.0.0.0

# Media
MEDIA_PATH=/var/lib/wagss/media
AUTO_DOWNLOAD_ALL=true
AUTO_DOWNLOAD_STICKER=true

# LibreOffice
LIBREOFFICE_PATH=/usr/bin/libreoffice

# Default users — JSON array, passwords are NOT in source code
# Generate with: node -e "console.log(JSON.stringify([{username:'admin',password:'YOUR_PASSWORD',displayName:'Admin'}]))"
DEFAULT_USERS=[{"username":"iamraf","password":"GANTI_PASSWORD","displayName":"Reno Ageng Fernando"},{"username":"vermaysha","password":"GANTI_PASSWORD","displayName":"Ashary Vermaysha"},{"username":"rickyen","password":"GANTI_PASSWORD","displayName":"Ricky Eko Novianto"}]

# Production mode
NODE_ENV=production
