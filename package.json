{
  "name": "wagss",
  "description": "Single-Account WhatsApp Gateway",
  "module": "src/index.ts",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "Reno",
    "url": "https://github.com/RenoXF"
  },
  "homepage": "https://github.com/RenoXF/wagss",
  "keywords": [
    "whatsapp",
    "whatsapp-gateway",
    "single-account"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RenoXF/wagss.git"
  },
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.0",
    "@types/p-queue": "^3.2.1",
    "bun-plugin-tailwind": "^0.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "prepare": "husky",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "printWidth": 80,
    "plugins": [
      "prettier-plugin-organize-imports"
    ],
    "organizeImportsSkipDestructiveCodeActions": true
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@types/qs": "^6.15.1",
    "audio-decode": "^3.11.0",
    "baileys": "7.0.0-rc14",
    "croner": "^10.0.1",
    "elysia": "^1.4.29",
    "jimp": "^1.6.1",
    "jose": "^6.2.8",
    "libphonenumber-js": "^1.13.8",
    "link-preview-js": "^4.0.4",
    "postgres": "^3.4.7",
    "qs": "^6.15.3",
    "readeof": "^1.1.0",
    "rotating-file-stream": "^3.2.9"
  },
  "trustedDependencies": [
    "baileys",
    "protobufjs"
  ]
}
