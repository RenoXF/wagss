# Postgres connection (Laravel-style env vars). DB_DATABASE wajib diisi
# untuk koneksi TCP. Jika dikosongkan, fallback ke unix-socket peer auth
# (`createdb wagss`).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=whatsapp
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOLED=false
# Secret untuk web-session JWT. CHANGE ME in production.
JWT_SECRET=change-me-to-a-long-random-string
# Server binding
PORT=3000
HOSTNAME=127.0.0.1
# Anti-spam: jika QR/pairing tak kunjung selesai dalam N detik, proses
# Baileys berhenti total (tidak regenerate QR 24/7). Default 300.
QR_TIMEOUT_SECONDS=300
# Lokasi cache media (on-demand download). Relative to project root.
MEDIA_PATH=data/media
# Auto-download semua media (tanpa batas, folder per tipe). Default false (opt-in).
AUTO_DOWNLOAD_ALL=false
# Auto-download semua sticker (kecil, selalu dipakai). Media lain on-demand jika AUTO_DOWNLOAD_ALL=false.
AUTO_DOWNLOAD_STICKER=true
# Auto-seed default user on first boot (if users table empty).
# Leave empty to disable auto-seed (use bun run db:seed instead).
# Kosongkan DEFAULT_PASSWORD untuk generate random (disarankan untuk production).
DEFAULT_USERNAME=root
DEFAULT_PASSWORD=
DEFAULT_DISPLAY_NAME=root